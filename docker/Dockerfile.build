# Wegwerp-bouwsandbox voor de LFS/BLFS-build (chapter 5+).
# Dit image wordt NOOIT onderdeel van het eindproduct (de ISO) — het is
# uitsluitend een reproduceerbare "host system" die aan de LFS-vereisten
# voldoet, identiek te gebruiken in GitHub Actions en lokaal.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        bison \
        gawk \
        texinfo \
        wget \
        curl \
        xz-utils \
        patch \
        python3 \
        perl \
        file \
        ca-certificates \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# lfs-gebruiker in het image zelf bakken (i.p.v. iedere run opnieuw via
# 00-prepare-host.sh) — nodig zodra een build in twee losse 'docker run'-
# aanroepen wordt opgesplitst (bootstrap-cache-checkpoint vs. hoofdstuk 8),
# zodat beide containers 'm meteen hebben zonder runtime-useradd.
RUN groupadd lfs && useradd -s /bin/bash -g lfs -m -k /dev/null lfs

WORKDIR /opt/lfs
