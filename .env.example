# .env.example
# Kopieer naar .env en vul lokaal in (op de doel-pc, via de first-boot
# wizard). Nooit een .env met echte waarden committen — .gitignore sluit
# 'm al uit, maar dubbel checken blijft de regel.

# Anthropic (Claude) API key — voor n8n-workflows / CLI-automatisering
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) API key
OPENAI_API_KEY=

# Google (Gemini) API key
GEMINI_API_KEY=

# Mistral API key
MISTRAL_API_KEY=

# Tailscale auth key (optioneel — alleen nodig voor headless/scripted
# 'tailscale up'; interactieve login via de wizard heeft dit niet nodig)
TAILSCALE_AUTHKEY=

# GitHub-authenticatie loopt via 'gh auth login' (first-boot wizard) —
# geen token hier opslaan.
